<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Integration tests covering host startup, configuration validation, and the fake upstream fixture.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Collections run serially here, which is a real cost and a deliberate one.

      WebApplicationFactory resolves a top-level-statements entry point through static handoff state
      shared across the process. Booting several hosts concurrently lets one factory observe
      another's provider, and the tests that deliberately fail startup then see an
      ObjectDisposedException instead of the validation failure they assert. Capping the thread
      count narrowed that window without closing it.
    -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentSplice.Api\AgentSplice.Api.csproj" />
    <ProjectReference Include="..\..\src\AgentSplice.Application\AgentSplice.Application.csproj" />
    <ProjectReference Include="..\..\src\AgentSplice.Domain\AgentSplice.Domain.csproj" />
    <ProjectReference Include="..\AgentSplice.TestSupport\AgentSplice.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
