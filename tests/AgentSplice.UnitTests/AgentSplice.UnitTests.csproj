<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Deterministic unit tests for domain rules, provenance, and configuration validation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentSplice.Application\AgentSplice.Application.csproj" />
    <ProjectReference Include="..\..\src\AgentSplice.Domain\AgentSplice.Domain.csproj" />
    <!--
      The request scanner and splicer are deterministic byte-level logic, so they are unit tested
      directly rather than only through the transport.
    -->
    <ProjectReference Include="..\..\src\AgentSplice.Protocols.OpenAI\AgentSplice.Protocols.OpenAI.csproj" />
    <!--
      The provider's timing boundaries are decided inside one body read, so which operation stamped
      them cannot be pinned down through a socket: a real transport cannot be asked to let time pass
      between the first byte and the last on demand. A stubbed handler and a controllable clock can.
    -->
    <ProjectReference Include="..\..\src\AgentSplice.Providers.LmStudio\AgentSplice.Providers.LmStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
