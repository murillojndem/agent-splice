{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HostFiltering": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "agentsplice": {
    "publicBaseUrl": "http://127.0.0.1:5280",
    "persistence": {
      "mode": "Sqlite",
      "connectionString": "Data Source=agentsplice.db",
      "metadataQueueCapacity": 1024
    },
    "runtimes": [
      {
        "id": "lmstudio-local",
        "displayName": "LM Studio (local)",
        "provider": "lmstudio",
        "baseUrl": "http://127.0.0.1:1234/v1",
        "apiKeyEnvironmentVariable": "LM_STUDIO_API_KEY",
        "enabled": true,
        "discovery": {
          "enabled": true,
          "cacheDuration": "00:00:30",
          "serveStaleOnFailure": true,
          "capabilityProbingEnabled": false
        },
        "timeouts": {
          "connect": "00:00:05",
          "responseHeaders": "00:00:30",
          "idleStream": "00:01:00",
          "total": "00:10:00"
        }
      }
    ],
    "aliases": [],
    "capture": {
      "metadataEnabled": true,
      "contentEnabled": false,
      "retention": {
        "metadata": "30:00:00:00",
        "content": "1:00:00:00"
      }
    },
    "compatibility": {
      "unsupportedFields": "Transparent"
    },
    "telemetry": {
      "otlp": {
        "enabled": false,
        "protocol": "HttpProtobuf"
      }
    },
    "dashboard": {
      "enabled": true,
      "rootPath": "dashboard"
    },
    "limits": {
      "maxRequestBodyBytes": 4194304,
      "maxUpstreamCompletionBodyBytes": 67108864,
      "maxCatalogueBodyBytes": 4194304,
      "maxStreamEventBytes": 1048576,
      "maxConcurrentCompletions": 64
    },
    "adapters": {
      "enabled": false
    }
  }
}
