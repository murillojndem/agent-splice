<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Composition root and transport only. Per CLAUDE.md, no domain or orchestration logic may live in
    this project's endpoints: they read a request into a value, call the application, and write the
    result.
  -->
  <PropertyGroup>
    <Description>AgentSplice gateway host.</Description>
    <UserSecretsId>agentsplice-api</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      The gateway has no static web assets: it serves the dashboard from the folder
      agentsplice:dashboard:rootPath names (ADR 0015). Since .NET 10 the Web SDK would otherwise
      publish an empty AgentSplice.Api.staticwebassets.endpoints.json beside the executable, a file
      no package listing names and nothing reads (ADR 0024).
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentSplice.Application\AgentSplice.Application.csproj" />
    <ProjectReference Include="..\AgentSplice.Infrastructure\AgentSplice.Infrastructure.csproj" />
    <ProjectReference Include="..\AgentSplice.Observability\AgentSplice.Observability.csproj" />
    <ProjectReference Include="..\AgentSplice.Protocols.OpenAI\AgentSplice.Protocols.OpenAI.csproj" />
    <ProjectReference Include="..\AgentSplice.Providers.LmStudio\AgentSplice.Providers.LmStudio.csproj" />
  </ItemGroup>

</Project>
