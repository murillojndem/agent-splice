<?xml version="1.0" encoding="utf-8"?>
<!--
  The macOS package (ADR 0029): a self-contained, single-file osx-arm64 build that runs on a Mac with
  Apple silicon and no .NET installed. .github/scripts/package.ps1 publishes with it, on macOS in CI,

    dotnet publish src/AgentSplice.Api/AgentSplice.Api.csproj -c Release -p:PublishProfile=osx-arm64

  and adds the dashboard build beside the executable. It is the Windows and Linux profiles' twin, and
  each setting is there for the reason win-x64.pubxml gives (ADR 0017): not trimmed, no ReadyToRun or
  compression, native libraries beside the executable (libe_sqlite3.dylib), no IIS assets, no
  development settings, and the runtime switch that makes the executable's directory the content root.
  The SDK signs the single-file executable ad hoc, on any host, because Apple silicon runs no unsigned
  code; nothing signs it with a developer identity. A contract test holds every package's profile to the
  same settings.
-->
<Project>

  <PropertyGroup>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishIISAssets>false</PublishIISAssets>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="AgentSplice.Hosting.ContentRootIsApplicationDirectory" Value="true" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
