<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows package (ADR 0017): a self-contained, single-file win-x64 build that runs on a machine
  with no .NET installed. .github/scripts/package.ps1 publishes with it,

    dotnet publish src/AgentSplice.Api/AgentSplice.Api.csproj -c Release -p:PublishProfile=win-x64

  and adds the dashboard build beside the executable. Everything specific to the package lives here,
  never in the project file: a runtime identifier or SelfContained there would change the container
  publish and break the test projects that reference this one. A contract test holds that line.

  - Not trimmed: ASP.NET Core and EF Core are not trim-safe — a trimmed .NET 10 publish raises
    IL2026 and IL2104 trim warnings — and warnings are errors.
  - No ReadyToRun and no compression: neither is needed for a local gateway, and both change what
    the executable is in ways the smoke test would have to re-prove.
  - Native libraries stay beside the executable (e_sqlite3.dll) instead of being extracted to a
    temporary directory at every start.
  - No IIS assets: the package is a process, not an IIS site, so no web.config and no IIS module.
  - appsettings.json stays a file beside the executable, where an operator can read it;
    appsettings.Development.json is not shipped.
  - The runtime switch makes the directory the executable is in the content root, so the package
    finds its settings and dashboard wherever it is started from (ContentRootDefault).
-->
<Project>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishIISAssets>false</PublishIISAssets>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="AgentSplice.Hosting.ContentRootIsApplicationDirectory" Value="true" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
