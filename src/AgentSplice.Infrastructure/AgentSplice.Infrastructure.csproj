<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentSplice infrastructure: configuration binding and hosting-adjacent composition.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentSplice.Application\AgentSplice.Application.csproj" />
    <ProjectReference Include="..\AgentSplice.Domain\AgentSplice.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- Provides OptionsBuilder.ValidateOnStart, so invalid configuration fails before readiness. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!--
      The metadata store. Confined to this project by docs/ARCHITECTURE.md; the Sqlite provider is
      the only one shipped in Stage 1C, and the model itself carries no provider-specific mapping so
      that the PostgreSQL contract stays open (FR-DATA-003).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!--
      Tooling only. PrivateAssets="all" keeps it out of the compiled assembly's references, which the
      module-boundary test relies on, and out of anything AgentSplice ships.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
