<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Instruments with System.Diagnostics alone. No OpenTelemetry SDK is referenced in Stage 1A, which
    an architecture test enforces; these are the primitives the SDK itself consumes, so adopting it
    later adds an exporter rather than rewriting instrumentation (ADR 0008).
  -->
  <PropertyGroup>
    <Description>AgentSplice observability names and instrumentation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentSplice.Application\AgentSplice.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
