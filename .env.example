# Copy to .env for Docker Compose. Never commit a real API key.
#
# AgentSplice settings use the double-underscore form that Microsoft.Extensions.Configuration maps
# onto the "agentsplice" section: AGENTSPLICE__PERSISTENCE__MODE binds agentsplice:persistence:mode.
# Names are matched case-insensitively.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5280

# Persistence: None or Sqlite. Postgres is refused at startup — FR-DATA-003 commits to it through
# the same contracts and the schema is kept provider-neutral for it, but no provider ships yet, and
# a mode that silently fell back to a local file would be worse than one that says so.
AGENTSPLICE__PERSISTENCE__MODE=Sqlite
AGENTSPLICE__PERSISTENCE__CONNECTIONSTRING=Data Source=/data/agentsplice.db

# Upstream runtime. host.docker.internal reaches LM Studio running on the host.
AGENTSPLICE__RUNTIMES__0__BASEURL=http://host.docker.internal:1234/v1

# The API key itself. The gateway is told the variable name, not the value.
LM_STUDIO_API_KEY=

# Raw prompt and response capture. Refused at startup if set to true: sanitisation, authorization,
# and independent content retention do not exist in this build, so accepting the flag would claim
# prompts were being retained safely when nothing retains them at all (FR-DATA-005, FR-DATA-006).
AGENTSPLICE__CAPTURE__CONTENTENABLED=false

# Bearer token for the administrative API under /api/v1. Required by the Compose configuration,
# because a container binds every interface inside itself and cannot tell that the host published
# the port on loopback only. Choose your own value; there is deliberately no default.
#
# When this is set, the token is required for every /api/v1 call including one from loopback: behind
# a local reverse proxy, "arrived from 127.0.0.1" and "was made locally" are the same observation.
#
# openssl rand -hex 32
AGENTSPLICE_ADMIN_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Scaffolding for the PostgreSQL profile. AgentSplice cannot use this database in this build; the
# service exists so the Compose topology does not have to be invented later.
POSTGRES_DB=agentsplice
POSTGRES_USER=agentsplice
POSTGRES_PASSWORD=change-me
