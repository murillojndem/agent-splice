# Copy to .env for Docker Compose. Never commit a real API key.
#
# AgentSplice settings use the double-underscore form that Microsoft.Extensions.Configuration maps
# onto the "agentsplice" section: AGENTSPLICE__PERSISTENCE__MODE binds agentsplice:persistence:mode.
# Names are matched case-insensitively.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5280

# Persistence: None, Sqlite, or Postgres.
AGENTSPLICE__PERSISTENCE__MODE=Sqlite
AGENTSPLICE__PERSISTENCE__CONNECTIONSTRING=Data Source=/data/agentsplice.db

# Upstream runtime. host.docker.internal reaches LM Studio running on the host.
AGENTSPLICE__RUNTIMES__0__BASEURL=http://host.docker.internal:1234/v1

# The API key itself. The gateway is told the variable name, not the value.
LM_STUDIO_API_KEY=

# Raw prompt and response capture. Off by default and sanitised when enabled (FR-DATA-005).
AGENTSPLICE__CAPTURE__CONTENTENABLED=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

POSTGRES_DB=agentsplice
POSTGRES_USER=agentsplice
POSTGRES_PASSWORD=change-me
